# PURPOSE: Provide safe local-development environment variable names and placeholder values.
# RESPONSIBILITY: Documents non-secret local configuration only; it must never contain live credentials or tokens.
# DEPENDENCIES: Local Docker Compose services and future application configuration.
# USED BY: Developers copying this file to an ignored .env file.
# TESTED BY: P01 environment/configuration checks.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

POSTGRES_DB=marketing_ai
POSTGRES_USER=marketing_ai
POSTGRES_PASSWORD=replace-with-a-local-dev-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
