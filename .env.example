# P03 typed application configuration and local Compose inputs.
# Initial business values are approved in BUSINESS_CONSTANTS.md; keep in sync.
# Copy only if .env is absent. Store real secrets only in the ignored local file.
ENVIRONMENT=local
LOG_LEVEL=INFO
POSTGRES_DB=marketing_ai
POSTGRES_USER=marketing_ai
POSTGRES_PASSWORD=
# Required PostgreSQL URL: postgresql+psycopg://user:URL_ENCODED_PASSWORD@host/database
DATABASE_URL=
# Same credentials may use host=postgres inside Compose, versus loopback on the host.
COMPOSE_DATABASE_URL=
# Required P03 operational settings; final deployment values await owner decision.
DATABASE_POOL_SIZE=
DATABASE_MAX_OVERFLOW=
DATABASE_POOL_TIMEOUT_SECONDS=
DATABASE_CONNECT_TIMEOUT_SECONDS=
DATABASE_READINESS_TIMEOUT_SECONDS=
# Redis remains optional until its integration phase.
REDIS_URL=
# Required P04 signed identity contract. Keep the secret only in ignored local/deployment config.
IDENTITY_JWT_ISSUER=
IDENTITY_JWT_AUDIENCE=
IDENTITY_JWT_HS256_SECRET=

MIN_DAILY_BUDGET_MAD=50
MAX_DAILY_BUDGET_MAD=500
MAX_DAILY_BUDGET_PER_SELLER_MAD=2000
MAX_BUDGET_INCREASE_PCT_PER_ACTION=25
MIN_HOURS_BETWEEN_BUDGET_CHANGES=24
BUDGET_CHANGE_REQUIRES_APPROVAL=true
MIN_STOCK_UNITS_TO_ADVERTISE=20
STOCK_FLOOR_TO_AUTO_PAUSE=5
MIN_GROSS_MARGIN_PCT=30
MAX_ACCEPTABLE_CANCELLATION_RATE_PCT=35
MAX_ACCEPTABLE_RETURN_RATE_PCT=15
MIN_ORDERS_FOR_RATE_CONFIDENCE=30
DELIVERY_COST_PER_ORDER_MAD=35
PROFITABILITY_ATTRIBUTION_WINDOW_DAYS=14
MIN_DAYS_BEFORE_PERFORMANCE_JUDGEMENT=3
MAX_GRAPH_STEPS=12
MAX_STRUCTURED_OUTPUT_RETRIES=2
LLM_REQUEST_TIMEOUT_SECONDS=60
MAX_INPUT_TOKENS_PER_RUN=20000
MAX_OUTPUT_TOKENS_PER_RUN=2000
MAX_AI_PROPOSALS_PER_SELLER_PER_DAY=20
MAX_LLM_COST_PER_SELLER_PER_DAY_MAD=10
MAX_SELLER_INSTRUCTION_CHARS=1000
IDEMPOTENCY_KEY_TTL_HOURS=72
META_WRITE_TIMEOUT_SECONDS=30
MAX_RETRIES_META_WRITE=3
EXECUTING_STATE_STALE_AFTER_MINUTES=10
RECONCILIATION_SCAN_INTERVAL_MINUTES=5
APPROVAL_PAYLOAD_TTL_MINUTES=30
PERFORMANCE_SYNC_INTERVAL_MINUTES=60
PERFORMANCE_SNAPSHOT_RETENTION_DAYS=400
META_API_RATE_LIMIT_BUFFER_PCT=20
SYNC_BACKFILL_MAX_DAYS=30
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=120
RATE_LIMIT_AI_ENDPOINTS_PER_MINUTE=5
SSE_MAX_STREAM_DURATION_SECONDS=300
RTO_MINUTES=60
RPO_MINUTES=15
BACKUP_RETENTION_DAYS=30
RESTORE_TEST_FREQUENCY_DAYS=90
